{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "vigam",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "routes": [
    { "pattern": "vigamai.com", "custom_domain": true },
    { "pattern": "www.vigamai.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
}
